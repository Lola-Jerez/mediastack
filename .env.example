# I copy this file to .env and fill in my real values: cp .env.example .env
# .env is in .gitignore, so my secrets never end up in git.

# --- mediastack ---
# I get my free key at https://mediastack.com/signup/free
MEDIASTACK_API_KEY=put_your_key_here

# What news I want (see https://mediastack.com/documentation for all options)
MEDIASTACK_LANGUAGES=en
MEDIASTACK_COUNTRIES=
MEDIASTACK_CATEGORIES=
MEDIASTACK_KEYWORDS=

# How many pages (1 page = 1 request = up to 100 articles) I fetch per run.
# My free plan only has 100 requests PER MONTH, so I keep this small.
MAX_PAGES_PER_RUN=1

# --- PostgreSQL (used by docker-compose.yml AND by my Node code) ---
POSTGRES_USER=news_user
POSTGRES_PASSWORD=change_me_to_something_long
POSTGRES_DB=news
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
